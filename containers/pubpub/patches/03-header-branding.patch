+.global-controls-component {
+	color: #ffffff !important;
+	.#{$bp}-button.#{$bp}-minimal {
+		color: #ffffff !important;
+		font-weight: 500;
+		&:hover {
+			color: #38bdf8 !important;
+			background-color: rgba(255, 255, 255, 0.08) !important;
+		}
+	}
+}
+
+/* High-Contrast User Initials Avatar */
+.header-component .avatar-component {
+	background: #1e3a5f !important;
+	border: 2px solid #38bdf8 !important;
+	color: #ffffff !important;
+	box-shadow: 0 0 10px rgba(56, 189, 248, 0.35) !important;
+	transition: all 0.2s ease !important;
+}
+
+.header-component button:hover .avatar-component {
+	border-color: #ffffff !important;
+	background: #2563eb !important;
+	box-shadow: 0 0 14px rgba(37, 99, 235, 0.6) !important;
+	transform: scale(1.05);
+}
+
+.header-component .avatar-component > div {
+	color: #ffffff !important;
+	font-weight: 700 !important;
+	letter-spacing: 0.05em !important;
+}
